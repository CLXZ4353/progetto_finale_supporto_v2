# Solo per modelli che supportano il controllo del reasoning (es. LFM3):
# vuoto = reasoning del modello (consigliato: migliora la scelta dei tool)
# none  = disattiva il reasoning per la scelta dei tool (più veloce, meno affidabile)
# LM_STUDIO_REASONING_EFFORT=none

